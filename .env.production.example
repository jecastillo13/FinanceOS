# Copia como .env únicamente en el servidor. Nunca lo subas a Git.
FINANCEOS_DOMAIN=finanzas.tudominio.com
POSTGRES_PASSWORD=GENERA_UNA_CLAVE_ALEATORIA_DE_32_O_MAS_CARACTERES
FINANCEOS_PUBLIC_SIGNUP=false

FINANCEOS_SMTP_HOST=smtp.tuproveedor.com
FINANCEOS_SMTP_PORT=587
FINANCEOS_SMTP_USER=usuario-smtp
FINANCEOS_SMTP_PASSWORD=SECRETO_SMTP
FINANCEOS_EMAIL_FROM=FinanceOS <no-reply@tudominio.com>
FINANCEOS_MFA_ENCRYPTION_KEY=GENERA_UNA_CLAVE_FERNET_Y_CONSERVALA_EN_EL_SERVIDOR
FINANCEOS_MFA_CURRENT_KEY_ID=primary
# Durante una rotación: anterior:CLAVE_FERNET_ANTERIOR,otra:OTRA_CLAVE
FINANCEOS_MFA_PREVIOUS_KEYS=
# Alternativa segura: ruta a la clave montada por Docker Secrets, Vault o KMS.
FINANCEOS_MFA_ENCRYPTION_KEY_FILE=

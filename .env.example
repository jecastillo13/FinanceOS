# SQLite local (valor predeterminado si se omite)
FINANCEOS_DATABASE_URL=sqlite:///database/finance.db

# Produccion/sincronizacion: postgresql+psycopg://usuario:clave@host:5432/financeos
# FINANCEOS_DATABASE_URL=postgresql+psycopg://financeos:CAMBIAR@localhost:5432/financeos

# Protege las rutas financieras. Usa una cadena larga y aleatoria.
FINANCEOS_API_TOKEN=CAMBIAR-POR-UN-TOKEN-SEGURO

# Dominios web permitidos, separados por coma.
FINANCEOS_CORS_ORIGINS=https://financeos.example.com

# El frontend compilado debe usar el mismo token.
VITE_API_TOKEN=CAMBIAR-POR-UN-TOKEN-SEGURO

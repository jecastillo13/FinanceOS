# SQLite local (valor predeterminado si se omite)
FINANCEOS_DATABASE_URL=sqlite:///database/finance.db

# Produccion/sincronizacion: postgresql+psycopg://usuario:clave@host:5432/financeos
# FINANCEOS_DATABASE_URL=postgresql+psycopg://financeos:CAMBIAR@localhost:5432/financeos

# Dominios web permitidos, separados por coma.
FINANCEOS_CORS_ORIGINS=https://financeos.example.com

# Desarrollo local: limita la API a este computador, emulador y red privada.
FINANCEOS_ENV=development
FINANCEOS_PRIVATE_NETWORK_ONLY=true
FINANCEOS_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,192.168.1.5
FINANCEOS_HTTPS=false
FINANCEOS_AUTH_REQUIRED=true
# Defensa adicional; Caddy limita a 12 MB y la API vuelve a comprobarlo.
FINANCEOS_MAX_REQUEST_BYTES=12582912

# false: instalación privada; el primer registro configura el superadmin local.
# true: publicación SaaS; todo registro web crea exclusivamente un usuario normal.
FINANCEOS_PUBLIC_SIGNUP=false

# URL pública usada en enlaces de verificación y recuperación.
FINANCEOS_PUBLIC_URL=http://localhost:8000

# En desarrollo pueden quedar vacíos: los enlaces se escriben en
# database/correo-desarrollo.txt. En producción SMTP es obligatorio.
FINANCEOS_SMTP_HOST=
FINANCEOS_SMTP_PORT=587
FINANCEOS_SMTP_USER=
FINANCEOS_SMTP_PASSWORD=
FINANCEOS_EMAIL_FROM=no-reply@financeos.local

# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FINANCEOS_MFA_ENCRYPTION_KEY=
